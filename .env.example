# 복사해서 .env로 사용하세요: cp .env.example .env
# .env는 절대 커밋하지 않습니다. (서버 값은 Parameter Store에서 주입, ADR-002)

APP_ENV=local
APP_VERSION=dev

# 로컬 Compose Postgres. 서버는 RDS(ADR-008)이며 Parameter Store 값이 주입됩니다.
DATABASE_URL=postgresql+psycopg://freesia:freesia@db:5432/freesia

# 컨테이너 시작 시 DB 마이그레이션 실행 여부. 로컬은 true, 서버는 false (배포 단계에서 따로 실행, ADR-013)
RUN_MIGRATIONS=true

# 프론트 주소 (쉼표로 여러 개)
CORS_ORIGINS=http://localhost:5173

# 배포 워크플로 콜백 서명 키 (ADR-009). 비어 있으면 콜백을 모두 거절한다.
# 서버는 Parameter Store /sbh/platform/demo/backend/DEPLOY_CALLBACK_SECRET 값이 주입된다.
DEPLOY_CALLBACK_SECRET=

# true면 워크플로를 부르지 않고 가짜 진행을 기록한다 (배포 레포 연결 전까지)
DEPLOY_SIMULATE=true

# 배포 레포(workload-deploy) 워크플로 실행용 GitHub 토큰. DEPLOY_SIMULATE=false일 때만 쓴다.
# 서버는 Parameter Store /sbh/platform/demo/backend/GITHUB_DEPLOY_TOKEN 값이 주입된다. 로컬에 실제 값을 커밋하지 않는다.
GITHUB_DEPLOY_TOKEN=
# DEPLOY_REPO=softbank-hackathon-2026/workload-deploy
# DEPLOY_REF=main
# 콜백 주소 앞부분. 배포 레포 deploy.yml의 CALLBACK_BASE와 같아야 한다
# PUBLIC_API_BASE=https://sbh.howon.me/api

# AI 분석 (Bedrock). 모델은 미정이라 값만 바꿔 고른다 (ADR-006). AWS 키는 넣지 않는다: 서버는 ECS 작업 역할, 로컬은 AWS_PROFILE
AI_MODEL_ID=
AI_AWS_REGION=ap-northeast-2
AI_TIMEOUT_SECONDS=60
# 모델이 JSON 스키마 출력을 지원하지 않으면 false (예: Nova 2 Lite)
AI_SCHEMA_OUTPUT=true

# Workload 계정 키 (모니터링: 배포된 앱의 지표·로그 읽기). 서버는 Parameter Store /sbh/platform/demo/backend/WORKLOAD_AWS_*
# AWS_ACCESS_KEY_ID 같은 기본 이름을 쓰지 않는다. 실제 값은 .env에만 넣고 커밋하지 않는다
WORKLOAD_AWS_ACCESS_KEY_ID=
WORKLOAD_AWS_SECRET_ACCESS_KEY=

# Sandbox 계정 키 (Workload와 같은 용도로 Sandbox 인프라·앱을 읽기). 서버는 Parameter Store /sbh/platform/demo/backend/SANDBOX_AWS_*
# 비어 있으면 Sandbox는 읽지 않는다
SANDBOX_AWS_ACCESS_KEY_ID=
SANDBOX_AWS_SECRET_ACCESS_KEY=

# 온프레미스(Proxmox) 인프라 조회. cloudflared 터널 뒤의 Proxmox API를 Cloudflare Access를 거쳐 읽기만 한다.
# 서버는 Parameter Store /sbh/platform/demo/backend/ONPREM_* 값이 주입된다. 5개가 다 있어야 읽는다 (하나라도 비면 온프레미스는 읽지 않는다)
# ONPREM_API_URL은 https:// 를 포함한 Proxmox API 주소, ONPREM_PVE_TOKEN_ID는 user@realm!토큰이름 형식. 실제 값은 .env에만 넣고 커밋하지 않는다
ONPREM_API_URL=
ONPREM_CF_CLIENT_ID=
ONPREM_CF_CLIENT_SECRET=
ONPREM_PVE_TOKEN_ID=
ONPREM_PVE_TOKEN_SECRET=
# 배포 때 cloudflared로 들어갈 서비스 VM 호스트 (예: vpn.howon.me, https:// 없이). 서버는 Parameter Store /sbh/platform/demo/backend/ONPREM_VM_HOST
# 비어 있어도 인프라 목록은 읽지만 그 인프라로는 배포할 수 없다
ONPREM_VM_HOST=
