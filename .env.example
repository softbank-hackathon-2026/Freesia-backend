# 복사해서 .env로 사용하세요: cp .env.example .env
# .env는 절대 커밋하지 않습니다. (서버 값은 Parameter Store에서 주입, ADR-002)

APP_ENV=local
APP_VERSION=dev

# 로컬 Compose Postgres. 서버 DB 방식은 ADR-007에서 결정되며 이 값만 바뀝니다.
DATABASE_URL=postgresql+psycopg://freesia:freesia@db:5432/freesia

# GitHub OAuth App (조직 설정 > Developer settings > OAuth Apps)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
GITHUB_OAUTH_SCOPE=read:user user:email

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# 아무 긴 랜덤 문자열: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=720
COOKIE_SECURE=false

# Fernet 키: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
