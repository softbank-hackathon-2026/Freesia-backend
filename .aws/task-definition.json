{
  "family": "sbh-platform-dev-ecs-api",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "X86_64"
  },
  "executionRoleArn": "arn:aws:iam::723225040786:role/sbh-platform-dev-role-ecs-execution",
  "taskRoleArn": "arn:aws:iam::723225040786:role/sbh-platform-dev-role-ecs-task",
  "containerDefinitions": [
    {
      "name": "app",
      "image": "<GitHub Actions가 ECR 이미지 주소@Digest로 교체>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "APP_ENV", "value": "dev" },
        { "name": "RUN_MIGRATIONS", "value": "false" },
        { "name": "CORS_ORIGINS", "value": "https://sbh.howon.me" },
        { "name": "DEPLOY_SIMULATE", "value": "false" },
        { "name": "AI_MODEL_ID", "value": "global.moonshotai.kimi-k3" },
        { "name": "AI_AWS_REGION", "value": "ap-northeast-2" },
        { "name": "AI_SCHEMA_OUTPUT", "value": "true" },
        { "name": "AI_TIMEOUT_SECONDS", "value": "60" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:723225040786:parameter/sbh/platform/demo/backend/DATABASE_URL"
        },
        {
          "name": "DEPLOY_CALLBACK_SECRET",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:723225040786:parameter/sbh/platform/demo/backend/DEPLOY_CALLBACK_SECRET"
        },
        {
          "name": "GITHUB_DEPLOY_TOKEN",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:723225040786:parameter/sbh/platform/demo/backend/GITHUB_DEPLOY_TOKEN"
        },
        {
          "name": "WORKLOAD_AWS_ACCESS_KEY_ID",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:723225040786:parameter/sbh/platform/demo/backend/WORKLOAD_AWS_ACCESS_KEY_ID"
        },
        {
          "name": "WORKLOAD_AWS_SECRET_ACCESS_KEY",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:723225040786:parameter/sbh/platform/demo/backend/WORKLOAD_AWS_SECRET_ACCESS_KEY"
        },
        {
          "name": "SANDBOX_AWS_ACCESS_KEY_ID",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:723225040786:parameter/sbh/platform/demo/backend/SANDBOX_AWS_ACCESS_KEY_ID"
        },
        {
          "name": "SANDBOX_AWS_SECRET_ACCESS_KEY",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:723225040786:parameter/sbh/platform/demo/backend/SANDBOX_AWS_SECRET_ACCESS_KEY"
        },
        {
          "name": "ONPREM_API_URL",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:723225040786:parameter/sbh/platform/demo/backend/ONPREM_API_URL"
        },
        {
          "name": "ONPREM_CF_CLIENT_ID",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:723225040786:parameter/sbh/platform/demo/backend/ONPREM_CF_CLIENT_ID"
        },
        {
          "name": "ONPREM_CF_CLIENT_SECRET",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:723225040786:parameter/sbh/platform/demo/backend/ONPREM_CF_CLIENT_SECRET"
        },
        {
          "name": "ONPREM_PVE_TOKEN_ID",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:723225040786:parameter/sbh/platform/demo/backend/ONPREM_PVE_TOKEN_ID"
        },
        {
          "name": "ONPREM_PVE_TOKEN_SECRET",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:723225040786:parameter/sbh/platform/demo/backend/ONPREM_PVE_TOKEN_SECRET"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "sbh-platform-dev-log-api",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/health', timeout=3)"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "stopTimeout": 30
    }
  ],
  "tags": [
    { "key": "Name", "value": "sbh-platform-dev-ecs-api" },
    { "key": "Project", "value": "SBH" },
    { "key": "Scope", "value": "platform" },
    { "key": "Environment", "value": "dev" },
    { "key": "ManagedBy", "value": "github-actions" },
    { "key": "Owner", "value": "박소정" }
  ]
}
